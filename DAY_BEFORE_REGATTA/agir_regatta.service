[Unit]
Description=Agir - Regatta autostart (live)
After=docker.service network-online.target
Wants=docker.service

[Service]
Type=simple
User=boat
Environment="HOME=/home/boat"
WorkingDirectory=/home/boat/2025_SOFTWARE/sailing_ros/DAY_BEFORE_REGATTA
ExecStart=/bin/bash /home/boat/2025_SOFTWARE/sailing_ros/DAY_BEFORE_REGATTA/run.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
