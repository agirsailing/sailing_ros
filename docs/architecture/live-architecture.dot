// Fixed node positions preserve layout independently of subscription arrow direction.
// Regenerate with: neato -Tsvg live-architecture.dot -o live-architecture.svg
digraph Agir {
graph [layout=neato, overlap=true, bgcolor="white", pad="0.25", nodesep="0.28", ranksep="0.75", splines=true, outputorder=edgesfirst, fontname="Arial"];
node [fontname="Arial", fontsize=12, margin="0.16,0.10", penwidth=1.2];
edge [fontname="Arial", fontsize=9, arrowsize=0.65, penwidth=0.8, color="#94a3b8", fontcolor="#475569", constraint=false];
UL [pos="0,-1.07!", pin=true, label="Left ultrasound\n/dev/ultrasonic_left", shape=box, style=filled, color="#64748b", fillcolor="#f1f5f9"];
UR [pos="0,-2.14!", pin=true, label="Right ultrasound\n/dev/ultrasonic_right", shape=box, style=filled, color="#64748b", fillcolor="#f1f5f9"];
GPS [pos="0,-3.21!", pin=true, label="GPS receiver\n/dev/gps", shape=box, style=filled, color="#64748b", fillcolor="#f1f5f9"];
BNO [pos="0,-4.28!", pin=true, label="BNO085 UART\n/dev/ttyAMA0", shape=box, style=filled, color="#64748b", fillcolor="#f1f5f9"];
BUS [pos="0,-5.35!", pin=true, label="I2C bus + multiplexer\nSeparate compass", shape=box, style=filled, color="#64748b", fillcolor="#f1f5f9"];
BAT [pos="0,-6.42!", pin=true, label="Battery voltage link\nand low-alarm GPIO", shape=box, style=filled, color="#64748b", fillcolor="#f1f5f9"];
LN [pos="3.7,-1.07!", pin=true, label="ultrasonic_left_node", shape=ellipse, style=filled, color="#2563eb", fillcolor="#dbeafe"];
RN [pos="3.7,-2.14!", pin=true, label="ultrasonic_right_node", shape=ellipse, style=filled, color="#2563eb", fillcolor="#dbeafe"];
GN [pos="3.7,-3.21!", pin=true, label="gps_node", shape=ellipse, style=filled, color="#2563eb", fillcolor="#dbeafe"];
IMUN [pos="3.7,-4.28!", pin=true, label="imu_sensor_node", shape=ellipse, style=filled, color="#2563eb", fillcolor="#dbeafe"];
IN [pos="3.7,-5.35!", pin=true, label="i2c_sensors_node", shape=ellipse, style=filled, color="#2563eb", fillcolor="#dbeafe"];
BN [pos="3.7,-6.42!", pin=true, label="battery_node", shape=ellipse, style=filled, color="#2563eb", fillcolor="#dbeafe"];
TL [pos="7.4,-1.07!", pin=true, label="/ultrasonic/left", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
TR [pos="7.4,-2.14!", pin=true, label="/ultrasonic/right", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
GPSRAW [pos="7.4,-3.21!", pin=true, label="/gps/data", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
TI [pos="7.4,-4.28!", pin=true, label="/imu/data", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
TC [pos="7.4,-5.3500000000000005!", pin=true, label="/compass/data", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
TB [pos="7.4,-6.42!", pin=true, label="/battery/data", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
MAG [pos="7.4,-7.49!", pin=true, label="/imu/mag", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
MT [pos="11.8,-1.07!", pin=true, label="imu_mount_transformer_node", shape=ellipse, style=filled, color="#2563eb", fillcolor="#dbeafe"];
MOUNT [pos="11.8,-2.14!", pin=true, label="/internal/imu/mounted", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
IMU [pos="11.8,-3.21!", pin=true, label="imu_node", shape=ellipse, style=filled, color="#2563eb", fillcolor="#dbeafe"];
AT [pos="11.8,-4.28!", pin=true, label="imu_aero_transformer_node", shape=ellipse, style=filled, color="#2563eb", fillcolor="#dbeafe"];
AEROB [pos="11.8,-5.3500000000000005!", pin=true, label="/internal/imu/aero_body", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
TF [pos="11.8,-6.42!", pin=true, label="/tf_static", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
HF [pos="11.8,-7.49!", pin=true, label="ultrasonic_filter_node", shape=ellipse, style=filled, color="#2563eb", fillcolor="#dbeafe"];
HN [pos="11.8,-8.56!", pin=true, label="heading_node", shape=ellipse, style=filled, color="#2563eb", fillcolor="#dbeafe"];
ROB [pos="16.2,-1.07!", pin=true, label="/processed/imu/data", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
RPY [pos="16.2,-2.14!", pin=true, label="/processed/imu/rpy", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
AERO [pos="16.2,-3.21!", pin=true, label="/processed/imu/data/aero", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
ARPY [pos="16.2,-4.28!", pin=true, label="/processed/imu/rpy/aero", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
HEIGHT [pos="16.2,-5.3500000000000005!", pin=true, label="/processed/boat_height", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
HEADING [pos="16.2,-6.42!", pin=true, label="/processed/heading_deg", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
GPSOUT [pos="16.2,-7.49!", pin=true, label="/processed/gps/summary", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
GW [pos="21,-1.07!", pin=true, label="telemetry_gateway_node", shape=ellipse, style=filled, color="#2563eb", fillcolor="#dbeafe"];
DASH [pos="21,-2.14!", pin=true, label="/web/ros/dashboard", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
MAP [pos="21,-3.21!", pin=true, label="/web/ros/map", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
CG [pos="21,-4.28!", pin=true, label="command_gateway_node", shape=ellipse, style=filled, color="#2563eb", fillcolor="#dbeafe"];
START [pos="21,-5.3500000000000005!", pin=true, label="Service:\n/local_cmd/start_recording", shape=hexagon, style=filled, color="#64748b", fillcolor="#f1f5f9"];
STOP [pos="21,-6.42!", pin=true, label="Service:\n/local_cmd/stop_recording", shape=hexagon, style=filled, color="#64748b", fillcolor="#f1f5f9"];
RM [pos="21,-7.49!", pin=true, label="rosbag_manager_node", shape=ellipse, style=filled, color="#2563eb", fillcolor="#dbeafe"];
STATE [pos="21,-8.56!", pin=true, label="/local_state/recording_state", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
REC [pos="21,-9.63!", pin=true, label="ROS bag recorder process", shape=ellipse, style=filled, color="#2563eb", fillcolor="#dbeafe"];
TOPICS [pos="21,-10.700000000000001!", pin=true, label="All discovered ROS topics\n(recorder subscription summary)", shape=box, style=filled, color="#64748b", fillcolor="#f1f5f9"];
FILES [pos="21,-11.770000000000001!", pin=true, label="MCAP files", shape=box, style=filled, color="#64748b", fillcolor="#f1f5f9"];
MD [pos="26,-1.07!", pin=true, label="agir_gui/data/dashboard", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
MM [pos="26,-2.14!", pin=true, label="agir_gui/data/map", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
MS [pos="26,-3.21!", pin=true, label="agir_gui/data/recording_state", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
CS [pos="26,-4.28!", pin=true, label="agir_gui/cmd/start_recording", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
CE [pos="26,-5.3500000000000005!", pin=true, label="agir_gui/cmd/stop_recording", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
RS [pos="26,-6.42!", pin=true, label="agir_gui/rsp/start_recording", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
RE [pos="26,-7.49!", pin=true, label="agir_gui/rsp/stop_recording", shape=box, style=filled, color="#c2410c", fillcolor="#ffedd5"];
WEB [pos="30.3,-1.07!", pin=true, label="Webapp\nMQTT over WSS", shape=box, style=filled, color="#64748b", fillcolor="#f1f5f9"];
H_HW [pos="0,0!", pin=true, label="Hardware", shape=box, style="rounded,filled", color="#0f172a", fillcolor="#0f172a", fontcolor=white, fontsize=15];
H_ACQ [pos="3.7,0!", pin=true, label="Acquisition nodes", shape=box, style="rounded,filled", color="#0f172a", fillcolor="#0f172a", fontcolor=white, fontsize=15];
H_RAW [pos="7.4,0!", pin=true, label="Sensor topics", shape=box, style="rounded,filled", color="#0f172a", fillcolor="#0f172a", fontcolor=white, fontsize=15];
H_PROC [pos="11.8,0!", pin=true, label="Processing / internal", shape=box, style="rounded,filled", color="#0f172a", fillcolor="#0f172a", fontcolor=white, fontsize=15];
H_OUT [pos="16.2,0!", pin=true, label="Processed topics", shape=box, style="rounded,filled", color="#0f172a", fillcolor="#0f172a", fontcolor=white, fontsize=15];
H_GATE [pos="21,0!", pin=true, label="Gateways / recording", shape=box, style="rounded,filled", color="#0f172a", fillcolor="#0f172a", fontcolor=white, fontsize=15];
H_MQTT [pos="26,0!", pin=true, label="MQTT broker topics", shape=box, style="rounded,filled", color="#0f172a", fillcolor="#0f172a", fontcolor=white, fontsize=15];
H_CLIENT [pos="30.3,0!", pin=true, label="Browser", shape=box, style="rounded,filled", color="#0f172a", fillcolor="#0f172a", fontcolor=white, fontsize=15];
UL -> LN [label="device", style=solid];
UR -> RN [label="device", style=solid];
GPS -> GN [label="device", style=solid];
BUS -> IN [label="device", style=solid];
BAT -> BN [label="device", style=solid];
LN -> TL [label="pub", style=solid];
RN -> TR [label="pub", style=solid];
GN -> GPSRAW [label="pub", style=solid];
BNO -> IMUN [label="device", style=solid];
IMUN -> TI [label="pub", style=solid];
IMUN -> MAG [label="pub", style=solid];
IN -> TC [label="pub", style=solid];
BN -> TB [label="pub", style=solid];
MT -> TI [label="sub", style=dashed];
MT -> MOUNT [label="pub", style=solid];
MT -> TF [label="TF lookup", style=dashed];
IMU -> MOUNT [label="sub", style=dashed];
IMU -> ROB [label="pub", style=solid];
IMU -> RPY [label="pub", style=solid];
IMU -> TF [label="pub", style=solid];
AT -> ROB [label="sub", style=dashed];
AT -> AEROB [label="pub", style=solid];
AT -> TF [label="TF lookup", style=dashed];
IMU -> AEROB [label="sub", style=dashed];
IMU -> AERO [label="pub", style=solid];
IMU -> ARPY [label="pub", style=solid];
HF -> TL [label="sub", style=dashed];
HF -> TR [label="sub", style=dashed];
HF -> ROB [label="sub", style=dashed];
HF -> HEIGHT [label="pub", style=solid];
HN -> GPSRAW [label="sub", style=dashed];
HN -> TC [label="sub", style=dashed];
HN -> HEADING [label="pub", style=solid];
HN -> GPSOUT [label="pub", style=solid];
GW -> TL [label="sub", style=dashed];
GW -> TR [label="sub", style=dashed];
GW -> ARPY [label="sub", style=dashed];
GW -> HEIGHT [label="sub", style=dashed];
GW -> GPSOUT [label="sub", style=dashed];
GW -> TB [label="sub", style=dashed];
GW -> STATE [label="sub", style=dashed];
GW -> DASH [label="pub", style=solid];
GW -> MAP [label="pub", style=solid];
GW -> MD [label="pub MQTT", style=solid];
GW -> MM [label="pub MQTT", style=solid];
GW -> MS [label="pub MQTT", style=solid];
WEB -> MD [label="sub", style=dashed];
WEB -> MM [label="sub", style=dashed];
WEB -> MS [label="sub", style=dashed];
WEB -> CS [label="pub", style=solid];
WEB -> CE [label="pub", style=solid];
CG -> CS [label="sub", style=dashed];
CG -> CE [label="sub", style=dashed];
CG -> RS [label="pub", style=solid];
CG -> RE [label="pub", style=solid];
WEB -> RS [label="sub", style=dashed];
WEB -> RE [label="sub", style=dashed];
CG -> START [label="calls", style=solid];
CG -> STOP [label="calls", style=solid];
RM -> START [label="serves", style=solid];
RM -> STOP [label="serves", style=solid];
RM -> STATE [label="pub", style=solid];
RM -> REC [label="start / stop", style=solid];
REC -> TOPICS [label="sub while recording", style=dashed];
REC -> FILES [label="writes", style=solid];
}
