<?xml version="1.0"?>
<package format="3">
  <name>data_elaboration</name>
  <version>0.0.0</version>
  <description>Sensor data processing for the Agir Sailing Team</description>
  <maintainer email="tech@agirsailing.se">Agir Sailing Team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensors</exec_depend>
  <exec_depend>sail_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>imu_transformer</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
